# Banco local
POSTGRES_DB=recruiter_platform
POSTGRES_USER=recruiter
POSTGRES_PASSWORD=recruiter
DB_URL=jdbc:postgresql://localhost:5432/recruiter_platform
DB_USERNAME=recruiter
DB_PASSWORD=recruiter

# Valores apenas para desenvolvimento; use um segredo forte e exclusivo fora do ambiente local.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=15m
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORPORATE_EMAIL_DOMAIN=empresa.com
